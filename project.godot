; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="PirateShipGame"
run/main_scene="res://main/main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Events="*res://autoload/events.gd"
GameState="*res://autoload/game_state.gd"
AudioManager="*res://autoload/audio_manager.gd"
KeybindsManager="*res://autoload/keybinds_manager.gd"
TouchInputManager="*res://autoload/touch_input_manager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg", "res://addons/pirate_dev_tools/plugin.cfg")

[input]

