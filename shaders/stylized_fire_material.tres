[gd_resource type="ShaderMaterial" load_steps=5 format=3]

; Shared instance — every dash burst writes the same DashStrength uniform.
; Cooldown ensures bursts never overlap, so the shared state is safe.
; If two FireQuads ever exist, duplicate this material first.

[ext_resource type="Shader" path="res://shaders/stylized_fire.gdshader" id="1_shader"]
[ext_resource type="NoiseTexture2D" path="res://resources/dash_fire_noise.tres" id="2_noise"]
[ext_resource type="Texture2D" path="res://textures/CircleBlur64x64.png" id="3_mask"]
[ext_resource type="GradientTexture1D" path="res://resources/dash_fire_gradient.tres" id="4_ramp"]

[resource]
shader = ExtResource("1_shader")
shader_parameter/NoiseTexture = ExtResource("2_noise")
shader_parameter/MaskTexture = ExtResource("3_mask")
shader_parameter/ColorRamp = ExtResource("4_ramp")
shader_parameter/TextureScale = Vector2(1.0, 1.0)
shader_parameter/TimeScale = 3.0
shader_parameter/EdgeSoftness = 0.1
shader_parameter/EmissionIntensity = 2.0
shader_parameter/DashStrength = 0.0
